{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":automergeDigest",
    ":automergeMinor"
  ],
  "automergeType": "branch",
  "pinDigest": {
    "automerge": true
  },
  "customManagers": [
    {
      // The Docker build installs Node from NodeSource's setup script, which no built-in manager reads
      "customType": "regex",
      "description": "Node major installed by the Dockerfile",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": ["deb\\.nodesource\\.com/setup_(?<currentValue>\\d+)\\.x"],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version",
      "versioningTemplate": "node"
    }
  ],
  "packageRules": [
    {
      // CI runs OpenTofu, which installs providers from the OpenTofu registry; it mirrors new
      // releases hours after registry.terraform.io, so look versions up there instead
      "matchDatasources": ["terraform-provider"],
      "registryUrls": ["https://registry.opentofu.org"]
    },
    {
      // CI and the Docker build should run the same Node major
      "groupName": "Node",
      "matchDepNames": ["node"]
    },
    {
      // oxlint declares a minimum oxlint-tsgolint version, and they release together
      "groupName": "Oxlint",
      "matchPackageNames": [
        "oxlint",
        "oxlint-tsgolint"
      ]
    },
    {
      // Always want to use latest version
      "matchDepNames": [
        "ghcr.io/amyjeanes/pandawebflasher/pandawebflasher"
      ],
      "matchUpdateTypes": [
        "pinDigest"
      ],
      "enabled": false
    }
  ]
}
