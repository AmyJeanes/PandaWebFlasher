{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":automergeDigest",
    ":automergeMinor"
  ],
  "automergeType": "branch",
  "pinDigest": {
    "automerge": true
  },
  "packageRules": [
    {
      // oxlint declares a minimum oxlint-tsgolint version, and they release together
      "groupName": "Oxlint",
      "matchPackageNames": [
        "oxlint",
        "oxlint-tsgolint"
      ]
    },
    {
      // Always want to use latest version
      "matchDepNames": [
        "ghcr.io/amyjeanes/pandawebflasher/pandawebflasher"
      ],
      "matchUpdateTypes": [
        "pinDigest"
      ],
      "enabled": false
    }
  ]
}
